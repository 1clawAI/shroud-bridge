{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shroud Bridge",
  "version": "0.1.3",
  "identifier": "xyz.1claw.shroud-bridge",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["shroudbridge"]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shroud Bridge",
        "width": 520,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local proxy to 1Claw Shroud",
    "longDescription": "Experimental desktop bridge that runs @1claw/cli proxy for OpenAI-compatible editors (Cursor, VS Code, etc.)."
  }
}
